    <worksheet name='Chart - Top Geographic Mismatch Routes'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Semibold'>Top Geographic Mismatch Routes</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fraud_analytics_tableau' name='federated.0noy1cy0js0pcn1h2p2p11ro45t3' />
          </datasources>
          <datasource-dependencies datasource='federated.0noy1cy0js0pcn1h2p2p11ro45t3'>
            <column caption='Geographic Risk Reason' datatype='string' name='[Calculation_200058372400873474]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [state_mismatch_flag] = 1 THEN &quot;State mismatch&quot;&#10;ELSEIF [city_mismatch_flag] = 1 THEN &quot;City mismatch&quot;&#10;ELSE &quot;No geographic mismatch&quot;&#10;END' />
            </column>
            <column caption='Geographic Route' datatype='string' name='[Calculation_200058372402331651]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[billing_city] + &quot; → &quot; + [shipping_city]' />
            </column>
            <column caption='Order ID' datatype='integer' name='[SalesOrderID]' role='dimension' type='ordinal' />
            <column caption='Billing City' datatype='string' name='[billing_city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='City Mismatch Flag' datatype='integer' name='[city_mismatch_flag]' role='measure' type='quantitative' />
            <column-instance column='[SalesOrderID]' derivation='CountD' name='[ctd:SalesOrderID:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_200058372400873474]' derivation='None' name='[none:Calculation_200058372400873474:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_200058372402331651]' derivation='None' name='[none:Calculation_200058372402331651:nk]' pivot='key' type='nominal' />
            <column caption='Shipping City' datatype='string' name='[shipping_city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='State Mismatch Flag' datatype='integer' name='[state_mismatch_flag]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0noy1cy0js0pcn1h2p2p11ro45t3].[Action (Geographic Risk Reason)]'>
            <groupfilter function='level-members' level='[Calculation_200058372400873474]' user:ui-action-filter='[Action7_CA23C8E0C1B344C9A2C17C42A148388D]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0noy1cy0js0pcn1h2p2p11ro45t3].[none:Calculation_200058372400873474:nk]' filter-group='3'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Calculation_200058372400873474:nk]' member='&quot;City mismatch&quot;' />
              <groupfilter function='member' level='[none:Calculation_200058372400873474:nk]' member='&quot;State mismatch&quot;' />
            </groupfilter>
          </filter>
          <manual-sort column='[federated.0noy1cy0js0pcn1h2p2p11ro45t3].[none:Calculation_200058372402331651:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Edmonds → Bothell&quot;</bucket>
              <bucket>&quot;Redmond → Sammamish&quot;</bucket>
